---
// Lijniconen, kleuren mee met de tekstkleur (currentColor).
const paths = {
  truck: '<path d="M2 6h11v10H2zM13 10h4l3 3v3h-7"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
  return: '<path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M8 5 4 9l4 4"/>',
  lock: '<rect x="5" y="10" width="14" height="10" rx="1.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  leaf: '<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19 13 11"/>',
  plant: '<path d="M12 21V11"/><path d="M12 11c0-4 3-6 7-6 0 4-3 6-7 6zM12 14c0-3-2-5-6-5 0 3 2 5 6 5z"/><path d="M7 21h10"/>',
  spool: '<path d="M6 4h12M6 20h12"/><path d="M8 4v16M16 4v16"/><path d="M8 8l8 2M8 12l8 2M8 16l8 2"/>',
  knit: '<path d="M4 5l4 7 4-7 4 7 4-7"/><path d="M4 12l4 7 4-7 4 7 4-7"/>',
  needle: '<path d="M4 20 18 6"/><ellipse cx="19.5" cy="4.5" rx="1.2" ry="2" transform="rotate(45 19.5 4.5)"/><path d="M4 20c3-1 4-3 3-5s-3-1-3 1"/>',
  menu: '<path d="M3 7h18M3 12h18M3 17h18"/>',
  star: '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" fill="currentColor" stroke="none"/>',
} as const;

interface Props { name: keyof typeof paths; class?: string }
const { name, class: cls = 'size-6' } = Astro.props;
---
<svg class:list={['shrink-0', cls]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />
