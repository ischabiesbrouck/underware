---
// Categoriepagina (boxers-heren.html, slips-heren.html): eigen URL en tekst per zoekterm,
// zodat Google deze pagina's apart kan tonen. Gebruikt in src/pages/boxers-heren.astro en slips-heren.astro.
import Base from '../layouts/Base.astro';
import ProductCard from './ProductCard.astro';
import { products, priceNumber, img, type Product } from '../data/products';
import { site, abs } from '../data/site';

interface Props {
  path: string; seoTitle: string; description: string; h1: string; display: string; intro: string;
  items: Product[]; points: [string, string][]; faq: [string, string][]; article?: [string, string];
}
const { path, seoTitle, description, h1, display, intro, items, points, faq, article } = Astro.props;
const itemList = { '@context': 'https://schema.org', '@type': 'ItemList', name: h1, itemListElement: items.map((p, i) => ({
  '@type': 'ListItem', position: i + 1, url: abs(`product-${p.slug}.html`), name: p.name, image: abs(img(p.slug, p.colors[0])) })) };
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: abs() }, { '@type': 'ListItem', position: 2, name: 'Shop', item: abs('shop.html') },
  { '@type': 'ListItem', position: 3, name: h1, item: abs(path) }] };
const from = Math.min(...items.map((p) => Number(priceNumber(p.price)))).toFixed(0);
const others = products.filter((p) => !items.includes(p)).slice(0, 2);
---
<Base title={seoTitle} description={description} path={path} current={path} schema={[itemList, faqLd, crumbs]}>
  <section class="pb-12 pt-10 md:pb-16 md:pt-16">
    <div class="wrap">
      <nav class="label mb-14 text-[10px] text-muted" aria-label="Kruimelpad"><a href="index.html" class="hover:text-ink">Home</a><span class="mx-3">/</span><a href="shop.html" class="hover:text-ink">Shop</a><span class="mx-3">/</span><span class="text-ink">{h1}</span></nav>
      <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:items-end">
        <div>
          <h1 class="label mb-8 flex items-center gap-4 text-muted"><span class="h-px w-10 bg-line"></span>{h1}</h1>
          <p class="display-xl animate-fade-up" set:html={display} />
        </div>
        <div>
          <p class="body-lg mb-6">{intro}</p>
          <p class="label text-[10px] text-muted">Vanaf € {from} · Gratis verzending vanaf € {site.freeShippingFrom} · Eerste maatwissel gratis</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line pb-20 pt-14">
    <div class="wrap grid gap-x-5 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((p, i) => <ProductCard product={p} delay={i % 3} />)}
    </div>
  </section>

  <section class="section-y border-t border-line bg-paper">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1.6fr] lg:gap-28">
      <h2 class="display-lg">Waarom <em>deze</em>?</h2>
      <ol class="border-t border-ink">
        {points.map(([t, d], i) => (
          <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-line py-6"><span class="font-display text-2xl italic text-moss">0{i + 1}</span>
            <div><h3 class="mb-1.5 text-[15px] font-medium">{t}</h3><p class="text-[14px] leading-relaxed text-muted">{d}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-y">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1.6fr] lg:gap-28">
      <div>
        <h2 class="display-lg mb-8">Vaak <em>gevraagd.</em></h2>
        {article && <a href={article[0]} class="link-line">{article[1]} →</a>}
      </div>
      <div class="border-t border-ink">
        {faq.map(([q, a], i) => (
          <details class="border-b border-line" open={i === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 font-display text-2xl">{q}<span class="plus font-sans text-xl font-light">+</span></summary>
            <p class="max-w-[38em] pb-7 text-[15px] leading-relaxed text-muted">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-y border-t border-line bg-paper">
    <div class="wrap">
      <h2 class="display-md mb-12">Ook in de collectie</h2>
      <div class="grid gap-x-5 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">{others.map((p, i) => <ProductCard product={p} delay={i} />)}</div>
    </div>
  </section>
</Base>
