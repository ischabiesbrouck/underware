---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, abs } from '../data/site';

interface Props {
  title: string; description: string; current?: string; overlay?: boolean;
  /** bestandsnaam van deze pagina, bv. 'shop.html' ('' = homepage); voor canonical-link en sitemap */
  path?: string; image?: string; type?: string; noindex?: boolean;
  /** extra gestructureerde gegevens (schema.org) voor Google */
  schema?: Record<string, unknown>[];
}
const { title, description, current, overlay = false, path = '', image = site.ogImage, type = 'website', noindex = false, schema = [] } = Astro.props;
const canonical = abs(path === 'index.html' ? '' : path);
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': abs('#organisatie'),
  name: site.name, legalName: site.legalName, url: abs(), logo: abs('img/favicon.svg'), email: site.email,
  ...(site.sameAs.length ? { sameAs: site.sameAs } : {}),
};
const web = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': abs('#website'), name: site.name, url: abs(), inLanguage: 'nl', publisher: { '@id': abs('#organisatie') } };
const ld = [org, web, ...schema];

const navLeft = [['shop.html', 'Shop'], ['boxers-heren.html', 'Boxers'], ['slips-heren.html', 'Slips']];
const navRight = [['journal.html', 'Journal'], ['maatgids.html', 'Maatgids'], ['over-ons.html', 'Over ons']];
const mobileNav = [['index.html', 'Home'], ['shop.html', 'Shop'], ['boxers-heren.html', 'Boxers'], ['slips-heren.html', 'Slips'], ['maatgids.html', 'Maatgids'], ['journal.html', 'Journal'], ['over-ons.html', 'Over ons'], ['contact.html', 'Contact']];
const footer = [
  ['Collectie', [['shop.html', 'Alles'], ['boxers-heren.html', 'Boxershorts heren'], ['slips-heren.html', 'Herenslips'], ['product-het-basispakket.html', 'Basispakket']]],
  ['Huis', [['over-ons.html', 'Over ons'], ['journal.html', 'Journal'], ['over-ons.html#materiaal', 'Materiaal'], ['over-ons.html#reis', 'Van veld tot naad'], ['contact.html', 'Contact']]],
  ['Service', [['maatgids.html', 'Maatgids'], ['index.html#beloftes', 'Onze beloftes'], ['contact.html#faq', 'Verzending & retour'], ['contact.html#faq', 'Veelgestelde vragen']]],
] as const;
const linkCls = 'label relative py-2 after:absolute after:inset-x-0 after:bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-500 hover:after:scale-x-100 aria-[current=page]:after:scale-x-100';
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#151513" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="img/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="sitemap.xml" />
    {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
    {site.plausibleDomain && <script is:inline defer data-domain={site.plausibleDomain} src="https://plausible.io/js/script.js"></script>}
    <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />
  </head>
  <body>
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-ink focus:px-4 focus:py-3 focus:text-bone">Naar de inhoud</a>
    <header data-header data-overlay={overlay ? '' : undefined}
      class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bone/90 text-ink backdrop-blur-md">
      {site.announcement.length > 0 && (
        <div class="flex h-8 items-center justify-center overflow-hidden bg-ink px-4 text-bone">
          <p class="label truncate text-[9.5px] sm:text-[10px]">
            <span>{site.announcement[0]}</span>
            {site.announcement.slice(1).map((t) => <span class="hidden md:inline"><span class="mx-4 text-taupe">·</span>{t}</span>)}
          </p>
        </div>
      )}
      <div class="wrap grid h-[72px] grid-cols-[1fr_auto_1fr] items-center">
        <nav class="hidden items-center gap-9 md:flex" aria-label="Collectie">
          {navLeft.map(([href, label]) => <a href={href} class={linkCls} aria-current={href === current ? 'page' : undefined}>{label}</a>)}
        </nav>
        <button data-menu-toggle class="-ml-2 flex items-center gap-3 p-2 md:hidden" aria-label="Menu openen" aria-expanded="false">
          <span class="relative block h-3 w-6"><span class="absolute inset-x-0 top-0 h-px bg-current"></span><span class="absolute inset-x-0 bottom-0 h-px bg-current"></span></span>
          <span class="label">Menu</span>
        </button>
        <a href="index.html" class="text-center text-[15px] font-medium tracking-[0.42em] uppercase md:text-base" aria-label="underware, naar de homepage">Underware</a>
        <nav class="hidden items-center justify-end gap-9 md:flex" aria-label="Huis">
          {navRight.map(([href, label]) => <a href={href} class={linkCls} aria-current={href === current ? 'page' : undefined}>{label}</a>)}
        </nav>
        <a href="shop.html" class="label justify-self-end md:hidden">Shop</a>
      </div>
    </header>

    <div data-menu class="pointer-events-none fixed inset-0 z-40 flex flex-col justify-between bg-bone px-5 pb-10 pt-36 opacity-0 transition-opacity duration-500 data-[open]:pointer-events-auto data-[open]:opacity-100 md:hidden">
      <nav class="grid gap-1" aria-label="Mobiel menu">
        {mobileNav.map(([href, label]) => <a href={href} class="font-display text-5xl leading-tight">{label}</a>)}
      </nav>
      <p class="label text-muted">Herenondergoed · 100% biologisch katoen · Gemaakt in Europa</p>
    </div>

    <main id="inhoud" class:list={[!overlay && (site.announcement.length ? 'pt-[104px]' : 'pt-[72px]')]}><slot /></main>

    <footer class="bg-ink text-[#b9b2a6]">
      <div class="wrap grid gap-16 py-20 lg:grid-cols-[1.3fr_2fr] lg:py-28">
        <div>
          <p class="display-md max-w-[11em] text-bone">Gemaakt om te blijven. <em class="text-taupe">Niet om te vervangen.</em></p>
          <!-- NIEUWSBRIEF: koppel aan Shopify Email, Mailchimp of Klaviyo door een action-URL op dit formulier te zetten. -->
          <p class="mt-8 max-w-sm text-[14px] leading-relaxed">Als eerste nieuwe kleuren en beperkte oplagen. Hoogstens één mail per maand, uitschrijven met één klik.</p>
          <form data-demo="Dank je. Je hoort binnenkort van ons." class="mt-6 flex max-w-md items-end gap-4 border-b border-[#3b3934] pb-2">
            <label class="grow"><span class="label mb-3 block text-taupe">Nieuwsbrief</span>
              <input type="email" required autocomplete="email" aria-label="E-mailadres" placeholder="Je e-mailadres" class="w-full bg-transparent py-1 text-bone outline-none placeholder:text-[#77716a]" /></label>
            <button class="label text-bone" type="submit">Inschrijven →</button>
          </form>
          <p data-note class="mt-3 min-h-5 text-sm text-taupe" aria-live="polite"></p>
        </div>
        <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
          {footer.map(([heading, links]) => (
            <div>
              <h4 class="label mb-6 text-bone">{heading}</h4>
              <ul class="grid gap-3 text-sm">{links.map(([href, label]) => <li><a class="transition-colors hover:text-bone" href={href}>{label}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </div>
      <div class="wrap">
        <div class="grid gap-6 border-y border-[#2e2c28] py-8 text-sm sm:grid-cols-2 lg:grid-cols-4">
          <p class="flex items-center gap-3"><Icon name="truck" class="size-5 text-taupe" />Gratis verzending vanaf € 60 (BE &amp; NL)</p>
          <p class="flex items-center gap-3"><Icon name="return" class="size-5 text-taupe" />Eerste maatwissel gratis</p>
          <p class="flex items-center gap-3"><Icon name="lock" class="size-5 text-taupe" />Veilig afrekenen via Shopify</p>
          <p class="flex items-center gap-3"><Icon name="leaf" class="size-5 text-taupe" />Plasticvrij verpakt</p>
        </div>
        <div aria-hidden="true" class="select-none overflow-hidden whitespace-nowrap py-6 text-center text-[clamp(2.6rem,11.5vw,11.5rem)] font-medium leading-none tracking-[0.14em] text-[#1f1e1b]">UNDERWARE</div>
        <div class="flex flex-wrap justify-between gap-4 pb-10 text-xs text-[#8b857c]">
          <span>© <span data-year>2026</span> underware. Alle rechten voorbehouden.</span>
          <!-- VUL AAN: controleer welke betaalmethodes je in Shopify activeert -->
          <span>Bancontact · iDEAL · Visa · Mastercard · Apple Pay</span>
        </div>
      </div>
    </footer>

    <script is:inline src="js/main.js"></script>
  </body>
</html>
