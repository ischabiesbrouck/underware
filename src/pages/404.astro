---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina niet gevonden | underware" path="404.html" noindex description="Deze pagina bestaat niet (meer). Ga naar de shop of de homepage van underware.">
  <section class="section-y">
    <div class="wrap max-w-[900px] text-center">
      <p class="label mb-8 text-muted">Fout 404</p>
      <h1 class="display-xl">Deze pagina is <em>zoek.</em></h1>
      <p class="body-lg mx-auto mt-8 max-w-[28em]">Misschien verhuisd, misschien nooit bestaan. Ons ondergoed vind je gelukkig wel.</p>
      <div class="mt-12 flex flex-wrap justify-center gap-3"><a href="/shop.html" class="btn">Naar de shop →</a><a href="/" class="btn btn-outline">Homepage</a></div>
    </div>
  </section>
</Base>
