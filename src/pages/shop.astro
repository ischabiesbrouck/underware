---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

const filters = [['alles', 'Alles'], ['boxers', 'Boxers'], ['slips', 'Slips'], ['sets', 'Sets']];
---
<Base title="Shop herenondergoed: boxers, trunks en slips | underware" path="shop.html" current="shop.html"
  description="Bekijk alle boxers, trunks en slips van underware: herenondergoed van 100% biologisch katoen, gemaakt in Europa. Vanaf € 24, gratis verzending vanaf € 60.">
  <section class="pb-12 pt-16 md:pb-16 md:pt-28">
    <div class="wrap grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:items-end">
      <div>
        <h1 class="label mb-8 flex items-center gap-4 text-muted"><span class="h-px w-10 bg-line"></span>Biologisch herenondergoed · Boxers, trunks en slips</h1>
        <p class="display-xl animate-fade-up">De <em>collectie.</em></p>
      </div>
      <p class="body-lg max-w-[26em] animate-fade-up">Een kleine, doordachte reeks. Elk stuk van 100% biologisch katoen, gemaakt in Europa en extra stevig afgewerkt.</p>
    </div>
  </section>

  <div class="sticky top-[104px] z-30 border-y border-line bg-bone/90 backdrop-blur-md">
    <div class="wrap flex items-center justify-between gap-6">
      <div class="-mb-px flex gap-7 overflow-x-auto md:gap-10" role="group" aria-label="Filter producten">
        {filters.map(([key, label], i) => (
          <button data-filter={key} data-active={i === 0 ? '' : undefined}
            class="label cursor-pointer whitespace-nowrap border-b border-transparent py-5 text-muted transition-colors hover:text-ink data-[active]:border-ink data-[active]:text-ink">{label}</button>
        ))}
      </div>
      <span data-count class="label shrink-0 text-[10px] text-muted">{products.length} producten</span>
    </div>
  </div>

  <section class="pb-24 pt-12 md:pt-16">
    <div class="wrap grid gap-x-5 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p, i) => <ProductCard product={p} delay={i % 3} />)}
    </div>
  </section>

  <section class="pb-24">
    <div class="wrap">
      <a href="product-het-basispakket.html" class="reveal studio-dark group grid overflow-hidden text-bone md:grid-cols-2">
        <div class="flex flex-col items-start justify-center p-10 md:p-20">
          <p class="label mb-6 text-taupe">Het Basispakket</p>
          <h2 class="display-lg mb-6">Drie boxers,<br /><em class="text-taupe">één keer goed.</em></h2>
          <p class="mb-10 text-[#a7a093]">Zwart, ecru en olijf voor € 75 in plaats van € 87.</p>
          <span class="link-line">Bekijk de set →</span>
        </div>
        <div class="flex items-center justify-center p-10">
          <img src="img/het-basispakket-zwart.svg" alt="Drie gevouwen boxers" class="w-full max-w-[400px] drop-shadow-[0_40px_50px_rgba(0,0,0,.5)] transition-transform duration-[1400ms] ease-(--ease-lux) group-hover:scale-105" />
        </div>
      </a>
    </div>
  </section>
</Base>
