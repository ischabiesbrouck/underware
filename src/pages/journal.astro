---
import Base from '../layouts/Base.astro';
import { articles } from '../data/journal';
import { abs } from '../data/site';
const list = { '@context': 'https://schema.org', '@type': 'Blog', name: 'underware journal', url: abs('journal.html'), inLanguage: 'nl',
  blogPost: articles.map((a) => ({ '@type': 'BlogPosting', headline: a.title, url: abs(`journal-${a.slug}.html`), datePublished: a.date })) };
---
<Base title="Journal: gidsen over herenondergoed | underware" path="journal.html" current="journal.html" schema={[list]}
  description="Eerlijke gidsen over herenondergoed: biologisch katoen, het juiste model kiezen en hoe je ondergoed jaren laat meegaan. Door underware.">
  <section class="pb-12 pt-16 md:pb-16 md:pt-28">
    <div class="wrap">
      <h1 class="label mb-8 flex items-center gap-4 text-muted"><span class="h-px w-10 bg-line"></span>Journal · Gidsen over herenondergoed</h1>
      <p class="display-xl animate-fade-up max-w-[11em]">Beter kiezen, <em>langer dragen.</em></p>
    </div>
  </section>
  <section class="border-t border-line pb-[clamp(5rem,11vw,10rem)] pt-14">
    <div class="wrap grid gap-x-5 gap-y-16 md:grid-cols-3">
      {articles.map((a, i) => (
        <a href={`journal-${a.slug}.html`} class:list={['reveal group block', `reveal-d${i % 3}`]}>
          <div class="studio mb-6 aspect-[4/3] overflow-hidden"><img src={a.image} alt="" loading="lazy" class="size-full object-cover transition-transform duration-[1400ms] ease-(--ease-lux) group-hover:scale-105" /></div>
          <p class="label mb-3 text-[10px] text-muted">{a.minutes} min lezen</p>
          <h2 class="mb-3 font-display text-3xl leading-tight">{a.title}</h2>
          <p class="text-[14px] leading-relaxed text-muted">{a.description}</p>
          <span class="link-line mt-5">Lees verder →</span>
        </a>
      ))}
    </div>
  </section>
</Base>
